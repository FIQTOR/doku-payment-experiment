# ============================================================
# DOKU (Jokul) Payment Gateway — Environment Configuration
# ============================================================
# Docs: https://developers.doku.com/
# These are sandbox/placeholder values. NEVER commit real secrets.
# ============================================================

# ---- Server ----
PORT=4010
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5174

# ---- DOKU (Jokul) credentials ----
# Your Client-Id issued by DOKU (Jokul). Sent as the `Client-Id` header.
DOKU_CLIENT_ID=BRN-0000-000000000000000000
# Shared secret key used for the HMAC-SHA256 request signature.
# Also used to validate inbound webhook notifications. Keep it secret.
DOKU_SECRET_KEY=change_me_secret_key

# Base URLs for DOKU Jokul
# Sandbox:  https://api-sandbox.doku.com
# Prod:     https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com

# Merchant-level identifiers
DOKU_MERCHANT_ID=YOUR_MERCHANT_ID
DOKU_TERMINAL_ID=TERMINAL-01

# Prefix for generated invoice numbers (alphanumeric, no spaces)
DOKU_INVOICE_PREFIX=INV

# ---- Public-key integration (optional) ----
# Path to DOKU's public key (PEM). Used as an RSA-SHA256 fallback for webhook
# signature verification when your account uses asymmetric keys. The key is NOT
# included in the repo — download it from the DOKU dashboard and save it here.
# Leave the file absent/unset to rely on HMAC verification only.
DOKU_PUBLIC_KEY_PATH=./certs/doku_public_key.pem

# ---- SNAP (Bank Indonesia standard) ----
# Path to YOUR RSA private key (PEM, PKCS#8). Used to sign SNAP Get-Token
# requests (SHA256withRSA). Generate with `npm run gen-key`.
DOKU_PRIVATE_KEY_PATH=./certs/private_key.pem
# SNAP partner id sent as X-PARTNER-ID (defaults to DOKU_CLIENT_ID when unset).
DOKU_PARTNER_ID=
# CHANNEL-ID sent with SNAP QRIS requests (H2H = host-to-host).
DOKU_CHANNEL_ID=H2H
# Default Direct API flavour when a payment doesn't specify one: nonsnap | snap
DOKU_API_FLAVOR=nonsnap

# ---- Webhook / callback ----
# Public URL where DOKU should send async notifications
PUBLIC_BASE_URL=http://localhost:4010

# ---- Experiment flags ----
# When true, all outbound DOKU calls are simulated locally (no network).
# Great for UI/flow experimentation without live sandbox credentials.
DOKU_MOCK_MODE=true

# ---- Rate limiting ----
# Max requests per IP per minute for /api/* (default: 120)
RATE_LIMIT_MAX=120

# ---- Persistence (optional MySQL via Sequelize) ----
# When false (default) the in-memory store is used — zero setup.
DB_ENABLED=false
# mysql (default) or sqlite (handy for tests / local quick start)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=doku_payments
DB_USER=root
DB_PASSWORD=
# sqlite only — file path or :memory: (used when DB_DIALECT=sqlite)
DB_STORAGE=:memory:
DB_LOGGING=false
DB_SYNC_ALTER=false
